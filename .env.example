# Copy to .env and fill in. None of these are needed to run the tests.

# OpenAI key used to pick a category and a match among the candidates.
OPENAI_API_KEY=

# Path to your private rule file. Defaults to config/categoryRules.example.json.
CATEGORY_RULES_PATH=

# Optional. Id of an expense category the agent must never assign.
BANK_AUTOMATION_EXCLUDED_CATEGORY_ID=
